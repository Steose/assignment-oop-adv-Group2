@startuml
class HomeController {
    + HomeController(logger:ILogger<HomeController>, weatherService:WeatherService, cache:IMemoryCache)
    + <<async>> Index(city:string) : Task<IActionResult>
    + Privacy() : IActionResult
    + Error() : IActionResult
}
class "ILogger`1"<T> {
}
Controller <|-- HomeController
HomeController --> "_logger<HomeController>" "ILogger`1"
HomeController --> "_cache" IMemoryCache
HomeController --> "_weatherService" WeatherService
@enduml
